local function make(class, props, parent)
    local o = Instance.new(class)
    for k, v in pairs(props) do o[k] = v end
    o.Parent = parent
    if class == "TextButton" or class == "TextBox" then
        Instance.new("UICorner", o).CornerRadius = UDim.new(0, 6)
    end
    return o
end

